# Database Configuration (libSQL / Turso / SQLite compatible)
# Local file mode: file:data/dsc_events.db
# Remote Turso mode (₹0 Starter Plan): libsql://<your-db>.turso.io
DATABASE_URL="file:data/dsc_events.db"
DATABASE_AUTH_TOKEN=""

# Application Host Base URL (used in email links, QR verification codes)
APP_BASE_URL="http://localhost:3000"

# Admin Authentication & First-Run Bootstrap Security
# Generate a cryptographically secure random secret (min 32 characters)
ADMIN_SECRET_KEY="generate-secure-random-token-here-minimum-32-chars"
# One-time bootstrap authorization token required to claim a new installation via CLI or UI
ADMIN_BOOTSTRAP_TOKEN="generate-one-time-bootstrap-token-here"

# Serverless Cron Worker Security (Vercel Cron / Webhook)
CRON_SECRET="generate-secure-cron-secret-for-scheduled-email-worker"

# Brevo Transactional Email Configuration (₹0 Free Tier: 300 emails/day)
# Transport options: smtp, brevo_api, mock
EMAIL_TRANSPORT="smtp"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="bfa4d1001@smtp-brevo.com"
# SMTP key begins with xsmtpsib-...
BREVO_SMTP_KEY="your-brevo-smtp-key-here"
# REST API v3 key begins with xkeysib-... (only needed if using brevo_api transport)
BREVO_API_KEY=""

EMAIL_FROM_ADDRESS="bfa4d1001@smtp-brevo.com"
EMAIL_FROM_NAME="DSC SVCE"

# Data Seeding Control (Set to true only for local development/testing)
SEED_DEMO_DATA="false"

# Optional Cloudflare Turnstile bot protection (Free tier)
CLOUDFLARE_TURNSTILE_SITE_KEY=""
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
