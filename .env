# Database Configuration (libSQL / Turso / SQLite compatible)
DATABASE_URL="file:data/dsc_events.db"
DATABASE_AUTH_TOKEN=""

# Application Host Base URL (used in email links, QR verification codes)
APP_BASE_URL="http://localhost:3000"

# Admin Authentication & First-Run Bootstrap Security
ADMIN_SECRET_KEY="local-dev-secret-key-minimum-32-chars-long-123456789"
ADMIN_BOOTSTRAP_TOKEN="bootstrap-token-12345678"

# Serverless Cron Worker Security
CRON_SECRET="local-dev-cron-secret-123456789"

# Email Configuration (using mock for local development)
EMAIL_TRANSPORT="mock"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="mock@dsc-svce.in"
BREVO_SMTP_KEY=""
BREVO_API_KEY=""

EMAIL_FROM_ADDRESS="no-reply@dsc-svce.in"
EMAIL_FROM_NAME="DSC SVCE"

# Data Seeding Control
SEED_DEMO_DATA="true"
